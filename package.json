{
  "name": "node-musickit-api",
  "version": "3.1.0-next.4",
  "description": "A wrapper for the Apple Music API written in NodeJS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages=external --sourcemap=external",
    "build:types": "bunx tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Exerra/node-musickit-api.git"
  },
  "keywords": [
    "node",
    "musickit",
    "node-musickit",
    "apple",
    "apple music",
    "music",
    "api"
  ],
  "author": "Savičs <exerra@exerra.xyz> (https://exerra.xyz)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Exerra/node-musickit-api/issues"
  },
  "dependencies": {
    "jose": "^6.2.3"
  }
}
